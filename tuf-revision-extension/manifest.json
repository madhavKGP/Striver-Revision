{
  "manifest_version": 3,
  "name": "TUF Revision Spree",
  "version": "1.2.0",
  "description": "A few random problems a day (you pick 1-20) from the ones you've solved on Striver's A2Z sheet, with revision tracking.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://takeuforward.org/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
